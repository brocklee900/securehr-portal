# Copy to .env and change every secret before sharing the stack.

# ---- Where the stack runs. Leave as is on a laptop. On the shared cloud server (README "Shared cloud server"):
#   SECUREHR_DOMAIN=myteam.duckdns.org   -> https://portal.myteam.duckdns.org, auth., gitea., jenkins.
#   KEYCLOAK_COMMAND=start               -> Keycloak production mode (start-dev is for laptops)
#   FRONTEND_TARGET=prod                 -> built frontend instead of the Vite dev server
#   LETSENCRYPT_EMAIL=you@example.com    -> used by scripts/get-public-certs.sh for certificate expiry warnings
SECUREHR_DOMAIN=localhost
KEYCLOAK_COMMAND=start-dev
FRONTEND_TARGET=dev
LETSENCRYPT_EMAIL=

# ---- Secrets
POSTGRES_PASSWORD=change-me-admin
# Change this if a local PostgreSQL installation already occupies 5432.
POSTGRES_HOST_PORT=5432
PORTAL_APP_PASSWORD=change-me-app
KEYCLOAK_DB_PASSWORD=change-me-kc
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-kc-admin
LDAP_ADMIN_PASSWORD=change-me-ldap
LDAP_READONLY_PASSWORD=change-me-ldap-readonly
MYSQL_ROOT_PASSWORD=change-me-mysql
JENKINS_ADMIN_PASSWORD=change-me-jenkins
JENKINS_OIDC_SECRET=change-me-jenkins-client-secret
GITEA_SECRET_KEY=change-me-gitea-secret-key
GITEA_OIDC_SECRET=change-me-gitea-client-secret
