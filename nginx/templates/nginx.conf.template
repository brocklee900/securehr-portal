# Template: the nginx image fills in ${SECUREHR_DOMAIN} at startup (see docker-compose.yml) and writes
# /etc/nginx/nginx.conf. Only SECUREHR_DOMAIN is substituted; nginx's own $variables are left alone.
events {}
http {
  ssl_certificate     /etc/nginx/certs/securehr.pem;
  ssl_certificate_key /etc/nginx/certs/securehr-key.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Host $host;
  proxy_buffer_size 128k;
  proxy_buffers 4 256k;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }

  include /etc/nginx/slo.conf;

  server {
    listen 80 default_server;
    # Let's Encrypt proves domain ownership over plain HTTP (scripts/get-public-certs.sh); everything else goes to HTTPS.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
  }

  server {
    listen 443 ssl;
    server_name portal.${SECUREHR_DOMAIN};
    # Query strings, bearer tokens and employee identifiers are deliberately omitted.
    access_log /dev/stdout portal_upstream;
    access_log /var/log/securehr/employee-search.log employee_search if=$employee_search_eligible;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    location /api/ {
      proxy_pass http://backend:8000/;
    }
    location / {
      proxy_pass http://frontend:5173;
      proxy_http_version 1.1;
      # Re-declare headers here: any proxy_set_header in a location discards the inherited ones.
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header Upgrade $http_upgrade;       # Vite HMR websocket
      proxy_set_header Connection $connection_upgrade;
    }
  }

  server {
    listen 443 ssl;
    server_name auth.${SECUREHR_DOMAIN};
    location / { proxy_pass http://keycloak:8080; }
  }

  server {
    listen 443 ssl;
    server_name jenkins.${SECUREHR_DOMAIN};
    location / { proxy_pass http://jenkins:8080; }
  }

  server {
    listen 443 ssl;
    server_name gitea.${SECUREHR_DOMAIN};
    client_max_body_size 100m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    location / {
      # Resolve on request so the portal can start before optional Gitea is configured.
      resolver 127.0.0.11 valid=30s ipv6=off;
      set $gitea_upstream http://gitea:3000;
      proxy_pass $gitea_upstream;
      proxy_http_version 1.1;
      # Re-declare headers here (see the portal server above); Upgrade/Connection carry Gitea's live-update WebSocket.
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
    }
  }
}
